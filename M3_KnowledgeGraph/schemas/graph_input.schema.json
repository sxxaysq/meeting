{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meeting.local/schemas/m3_graph_input.schema.json",
  "title": "M3 Knowledge Graph Input Envelope",
  "description": "M3 输入信封 = M2 正式输出（冻结契约，通过 $ref 引用独立的 m2_output.schema.json，逐字不改 M2 字段）+ 文档级元数据。M3 不改动 M2 任何字段。",
  "type": "object",
  "required": [
    "m2_output",
    "source_document_id",
    "meeting_date"
  ],
  "additionalProperties": true,
  "properties": {
    "m2_output": {
      "$ref": "https://meeting.local/schemas/m2_output.schema.json"
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "meeting_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ingest_mode": {
      "type": "string",
      "enum": [
        "formal",
        "forced"
      ]
    }
  }
}
