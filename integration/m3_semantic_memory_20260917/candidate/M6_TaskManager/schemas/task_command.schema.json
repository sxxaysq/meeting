{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting.local/schemas/task_command.schema.json",
  "title": "M6 validated task command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "target_task_id",
    "expected_version",
    "source_document_id",
    "source_item_id",
    "event_content",
    "reason",
    "changes",
    "department_change",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "m6.task_command.v1"},
    "action": {
      "enum": [
        "CREATE",
        "PROGRESS_UPDATE",
        "MODIFY",
        "COMPLETE",
        "CANCEL",
        "REOPEN",
        "TRANSFER",
        "REVIEW",
        "SKIP",
        "ROUTE_M4"
      ]
    },
    "target_task_id": {"type": ["string", "null"]},
    "expected_version": {"type": ["integer", "null"], "minimum": 1},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_item_id": {"type": "string", "minLength": 1},
    "event_content": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "changes": {"type": "object"},
    "department_change": {"type": ["object", "null"]},
    "provenance": {"type": "object"}
  }
}
