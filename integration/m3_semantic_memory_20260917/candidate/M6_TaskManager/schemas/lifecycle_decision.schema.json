{
 "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["decision","target_index","fields","scope","reason","evidence"],
 "properties":{
  "decision":{"enum":["CREATE","PROGRESS_UPDATE","MODIFY","COMPLETE","CANCEL","REOPEN","TRANSFER","REVIEW","SKIP","EXPAND","MULTI"]},
  "target_index":{"type":["integer","null"],"minimum":0},
  "fields":{"type":"array","uniqueItems":true,"items":{"enum":["title","description","work_section","delivery_group","assignees"]}},
  "scope":{"enum":["same_task","subtask","uncertain"]},
  "reason":{"type":"string","minLength":1,"maxLength":500},
  "evidence":{"type":["string","null"]},"transfer_to":{"type":["string","null"]},
  "sub_decisions":{"type":"array","minItems":2,"maxItems":3,"items":{"$ref":"#/$defs/sub_decision"}}
 },
 "$defs":{
  "sub_decision":{
   "type":"object","additionalProperties":false,
   "required":["decision","target_index","fields","scope","reason","evidence"],
   "properties":{
    "decision":{"enum":["CREATE","PROGRESS_UPDATE","MODIFY","COMPLETE","CANCEL","REOPEN","TRANSFER","SKIP"]},
    "target_index":{"type":["integer","null"],"minimum":0},
    "fields":{"type":"array","uniqueItems":true,"items":{"enum":["title","description","work_section","delivery_group","assignees"]}},
    "scope":{"enum":["same_task","subtask","uncertain"]},
    "reason":{"type":"string","minLength":1,"maxLength":500},
    "evidence":{"type":["string","null"]},"transfer_to":{"type":["string","null"]}
   },
   "allOf":[
    {"if":{"properties":{"decision":{"const":"CREATE"}}},"then":{"properties":{"target_index":{"type":"null"}}}},
    {"if":{"properties":{"decision":{"not":{"const":"CREATE"}}}},"then":{"properties":{"target_index":{"type":"integer"}}}},
    {"if":{"properties":{"decision":{"not":{"const":"MODIFY"}}}},"then":{"properties":{"fields":{"maxItems":0}}}}
   ]
  }
 },
 "allOf":[
  {"if":{"properties":{"decision":{"enum":["CREATE","REVIEW","EXPAND","MULTI"]}}},"then":{"properties":{"target_index":{"type":"null"}}}},
  {"if":{"properties":{"decision":{"not":{"const":"MODIFY"}}}},"then":{"properties":{"fields":{"maxItems":0}}}},
  {"if":{"properties":{"decision":{"const":"MULTI"}}},"then":{"required":["sub_decisions"]}},
  {"if":{"properties":{"decision":{"not":{"const":"MULTI"}}}},"then":{"not":{"required":["sub_decisions"]}}}
 ]
}
