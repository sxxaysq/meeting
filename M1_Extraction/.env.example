# M1_Extraction 模型与运行配置
# 复制为 .env 后按环境填写；仓库不包含任何真实凭据。

# ---- 模型接口（OpenAI Chat Completions 兼容）----------------------
# 业务逻辑里不写死模型名，全部由这里注入。
# 默认：192.168.30.215 上的 vLLM，max_model_len 262144，无需 API Key。
LLM_BASE_URL=http://192.168.30.215:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
LLM_TIMEOUT=900

# ---- 传输层 -------------------------------------------------------
# openai：标准 /v1/chat/completions（默认，vLLM / 云端模型用这个）
# ollama：改用 Ollama 原生 /api/chat。
#         原因：本机 Ollama(7060) 的 OpenAI 兼容层把上下文硬截断到 4096 token
#         （实测 9000 token 输入的 prompt_tokens 仍是 4096），长 Block 会被
#         悄悄截断；原生接口支持 options.num_ctx。只影响传输，不影响提示词。
#         用 Ollama 时改成：
#           LLM_BASE_URL=http://127.0.0.1:7060/v1
#           LLM_MODEL=qwen3:30b
#           LLM_TRANSPORT=ollama
#           LLM_NUM_CTX=8192
LLM_TRANSPORT=openai

# ---- 思考模式 -----------------------------------------------------
# Qwen3.x 这类思考型模型默认把推理写进独立的 reasoning 字段，content 直接是 null，
# 解析必然失败。false 会发送 chat_template_kwargs.enable_thinking=false。
# 服务端不认识这个参数时，留空（LLM_ENABLE_THINKING=）表示完全不发送。
LLM_ENABLE_THINKING=false

# 需要额外透传给 /chat/completions 的字段（JSON 对象），一般用不到。
# LLM_EXTRA_BODY={"top_p":0.8}

# ---- 生成参数 -----------------------------------------------------
LLM_TEMPERATURE=0
# 条目密集的 Block 一次能产出 25+ 个 Item；4096 会把 JSON 截断导致整块作废。
LLM_MAX_TOKENS=8192

# ---- 切分 ---------------------------------------------------------
# Block 字符上限。只在条目行边界切开，不会从项目描述内部切断。
M1_MAX_BLOCK_CHARS=1200
