{
 "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["decision","target_index","fields","scope","reason","evidence"],
 "properties":{
  "decision":{"enum":["CREATE","PROGRESS_UPDATE","MODIFY","COMPLETE","CANCEL","REOPEN","TRANSFER","REVIEW","SKIP","EXPAND"]},
  "target_index":{"type":["integer","null"],"minimum":0},
  "fields":{"type":"array","uniqueItems":true,"items":{"enum":["title","description","work_section","delivery_group","assignees"]}},
  "scope":{"enum":["same_task","subtask","uncertain"]},
  "reason":{"type":"string","minLength":1,"maxLength":500},
  "evidence":{"type":["string","null"]},"transfer_to":{"type":["string","null"]}
 },
 "allOf":[
  {"if":{"properties":{"decision":{"enum":["CREATE","REVIEW","EXPAND"]}}},"then":{"properties":{"target_index":{"type":"null"}}}},
  {"if":{"properties":{"decision":{"not":{"const":"MODIFY"}}}},"then":{"properties":{"fields":{"maxItems":0}}}}
 ]
}
