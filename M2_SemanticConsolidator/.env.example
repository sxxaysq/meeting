# M2 的模型配置。与 M1 完全一致，模型名不写死在业务逻辑里。
LLM_BASE_URL=http://192.168.30.215:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
LLM_TRANSPORT=openai
LLM_TIMEOUT=900

# Qwen3.x 默认把推理写进独立的 reasoning 字段，content 直接是 null，
# 不关思考解析必然失败。留空字符串则完全不发送该参数（给不认识它的服务端）。
LLM_ENABLE_THINKING=false

# M2 每次只把两条 Item 交给模型，输出很短，8192 绰绰有余。
# 注意：M1 的 generic 模式是整篇一次抽取，那边需要 32768，别混用。
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0

# 用 Ollama 时必须换传输层，否则 OpenAI 兼容层会把上下文硬截断到 4096 token
# LLM_TRANSPORT=ollama
# LLM_NUM_CTX=8192
