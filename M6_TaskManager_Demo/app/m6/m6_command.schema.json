{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M6 database command batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_key", "commands"],
  "properties": {
    "schema_version": {"const": "m6_db_command_v1"},
    "source_key": {"type": "string", "minLength": 1},
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_index",
          "db_action",
          "target_task_id",
          "expected_version",
          "task_patch",
          "evidence",
          "reason_code",
          "ambiguities"
        ],
        "properties": {
          "command_index": {"type": "integer", "minimum": 1, "maximum": 4},
          "db_action": {
            "enum": [
              "CREATE",
              "UPDATE_FIELDS",
              "UPDATE_STATUS",
              "SOFT_DELETE",
              "NOOP"
            ]
          },
          "target_task_id": {"type": ["string", "null"]},
          "expected_version": {"type": ["integer", "null"], "minimum": 1},
          "task_patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description",
              "work_items",
              "assignee_raw",
              "deadline_raw",
              "status"
            ],
            "properties": {
              "title": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "work_items": {
                "type": ["array", "null"],
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "assignee_raw": {"type": ["string", "null"]},
              "deadline_raw": {"type": ["string", "null"]},
              "status": {
                "type": ["string", "null"],
                "enum": [
                  "open",
                  "in_progress",
                  "blocked",
                  "completed",
                  "cancelled",
                  null
                ]
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "subsegment_id",
              "text"
            ],
            "properties": {
              "segment_id": {"type": "string", "minLength": 1},
              "subsegment_id": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "text": {"type": "string", "minLength": 1}
            }
          },
          "reason_code": {"type": "string", "minLength": 1},
          "ambiguities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
